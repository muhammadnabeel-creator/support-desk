# SupportDesk AI — example environment variables (placeholders only; never commit real values).
# The app does not read a .env file by itself: export these in your shell, put them in an MCP client's
# "env" block, or (recommended for the key) use `dotnet user-secrets` as shown in README.md.
# A double underscore (__) stands for the ":" in a configuration key.

# Groq API key (required only for the analyze and draft-reply features; everything else works without it)
Ai__Groq__ApiKey=<your-groq-api-key>

# Optional overrides (defaults shown, from appsettings.json)
Ai__Groq__Model=openai/gpt-oss-120b
Ai__Groq__BaseUrl=https://api.groq.com/openai/v1
Ai__TimeoutSeconds=20
Ai__MaxRequestsPerMinute=10

# Optional: absolute database path, only needed when running a copied/published build outside the repo
# ConnectionStrings__SupportDesk=Data Source=/absolute/path/to/supportdesk.db
