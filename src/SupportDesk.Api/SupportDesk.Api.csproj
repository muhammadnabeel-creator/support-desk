<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML doc comments feed Swagger. CS1591 (missing comment) is on: every public member needs a summary. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The Groq API key is kept with `dotnet user-secrets`, outside the repository (NFR2.13, NFR8.14). -->
    <UserSecretsId>supportdesk-api-7f3c2a1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
